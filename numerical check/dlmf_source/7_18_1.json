 "latex": [
  "\\displaystyle\\mathop{\\mathrm{i}^{-1}\\mathrm{erfc}}\\left(z\\right)",
  "\\mathop{\\mathrm{i}^{\\NVar{n}}\\mathrm{erfc}}\\left(\\NVar{z}\\right)",
  "\\displaystyle\\mathop{\\mathrm{i}^{0}\\mathrm{erfc}}\\left(z\\right)",
  "\\displaystyle=\\frac{2}{\\sqrt{\\pi}}e^{-z^{2}},",
  "\\displaystyle=\\operatorname{erfc}z,",
