 "kind": "equation",
 "latex": [
  "\\displaystyle=-\\mathsf{V}\\left(x,t\\right).",
  "\\displaystyle=\\mathsf{U}\\left(x,t\\right),",
  "\\mathsf{V}\\left(\\NVar{x},\\NVar{t}\\right)",
  "\\displaystyle\\mathsf{U}\\left(-x,t\\right)",
  "\\displaystyle\\mathsf{V}\\left(-x,t\\right)",
  "\\mathsf{U}\\left(\\NVar{x},\\NVar{t}\\right)",
  "x"
 ],
 "eqs": [],
 "section_eqs": [
  [
   "7.19.1",
   "\\mathsf{U}\\left(x,t\\right)=\\frac{1}{\\sqrt{4\\pi t}}\\int_{-\\infty}^{\\infty}\\frac{e^{-(x-y)^{2}/(4t)}}{1+y^{2}}\\,\\mathrm{d}y,"
  ],
  [
   "7.19.2",
   "\\mathsf{V}\\left(x,t\\right)=\\frac{1}{\\sqrt{4\\pi t}}\\int_{-\\infty}^{\\infty}\\frac{ye^{-(x-y)^{2}/(4t)}}{1+y^{2}}\\,\\mathrm{d}y."
  ],
  [
   "7.19.3",
   "\\mathsf{U}\\left(x,t\\right)+i\\mathsf{V}\\left(x,t\\right)=\\sqrt{\\frac{\\pi}{4t}}e^{z^{2}}\\operatorname{erfc}z,"
  ],
  [
   "7.19.4",
   "H\\left(a,u\\right)=\\frac{a}{\\pi}\\int_{-\\infty}^{\\infty}\\frac{e^{-t^{2}}\\,\\mathrm{d}t}{(u-t)^{2}+a^{2}}=\\frac{1}{a\\sqrt{\\pi}}\\mathsf{U}\\left(\\frac{u}{a},\\frac{1}{4a^{2}}\\right)."
  ],
  [
   "7.19.5",
   "\\displaystyle\\lim_{t\\to 0}\\mathsf{U}\\left(x,t\\right)"
  ],
  [
   "7.19.6",
   "\\displaystyle=-\\mathsf{V}\\left(x,t\\right)."
  ],
  [
   "7.19.7",
   "\\displaystyle\\leq\\mathsf{V}\\left(x,t\\right)\\leq 1."
  ],
  [
   "7.19.8",
   "\\displaystyle=x\\mathsf{U}\\left(x,t\\right)+2t\\frac{\\partial\\mathsf{U}\\left(x,t\\right)}{\\partial x},"
  ],
  [
   "7.19.9",
   "\\displaystyle=1-x\\mathsf{V}\\left(x,t\\right)-2t\\frac{\\partial\\mathsf{V}\\left(x,t\\right)}{\\partial x}."
  ],
  [
   "7.19.10",
   "\\mathsf{U}\\left(\\frac{u}{a},\\frac{1}{4a^{2}}\\right)=a\\int_{0}^{\\infty}e^{-at-\\frac{1}{4}t^{2}}\\cos\\left(ut\\right)\\,\\mathrm{d}t,"
  ],
  [
   "7.19.11",
   "\\mathsf{V}\\left(\\frac{u}{a},\\frac{1}{4a^{2}}\\right)=a\\int_{0}^{\\infty}e^{-at-\\frac{1}{4}t^{2}}\\sin\\left(ut\\right)\\,\\mathrm{d}t."
  ]
 ],
