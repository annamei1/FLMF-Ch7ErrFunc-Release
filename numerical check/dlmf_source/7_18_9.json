 "section_eqs": [
  [
   "7.18.1",
   "\\displaystyle\\mathop{\\mathrm{i}^{-1}\\mathrm{erfc}}\\left(z\\right)"
  ],
  [
   "7.18.2",
   "\\mathop{\\mathrm{i}^{n}\\mathrm{erfc}}\\left(z\\right)=\\int_{z}^{\\infty}\\mathop{\\mathrm{i}^{n-1}\\mathrm{erfc}}\\left(t\\right)\\,\\mathrm{d}t=\\frac{2}{\\sqrt{\\pi}}\\int_{z}^{\\infty}\\frac{(t-z)^{n}}{n!}e^{-t^{2}}\\,\\mathrm{d}t."
  ],
  [
   "7.18.3",
   "\\frac{\\mathrm{d}}{\\mathrm{d}z}\\mathop{\\mathrm{i}^{n}\\mathrm{erfc}}\\left(z\\right)=-\\mathop{\\mathrm{i}^{n-1}\\mathrm{erfc}}\\left(z\\right),"
  ],
  [
   "7.18.4",
   "\\frac{{\\mathrm{d}}^{n}}{{\\mathrm{d}z}^{n}}\\left(e^{z^{2}}\\operatorname{erfc}z\\right)=(-1)^{n}2^{n}n!e^{z^{2}}\\mathop{\\mathrm{i}^{n}\\mathrm{erfc}}\\left(z\\right),"
  ],
  [
   "7.18.5",
   "W(z)=A\\mathop{\\mathrm{i}^{n}\\mathrm{erfc}}\\left(z\\right)+B\\mathop{\\mathrm{i}^{n}\\mathrm{erfc}}\\left(-z\\right)"
  ],
  [
   "7.18.6",
   "\\mathop{\\mathrm{i}^{n}\\mathrm{erfc}}\\left(z\\right)=\\sum_{k=0}^{\\infty}\\frac{(-1)^{k}z^{k}}{2^{n-k}k!\\Gamma\\left(1+\\frac{1}{2}(n-k)\\right)}."
  ],
  [
   "7.18.7",
   "\\mathop{\\mathrm{i}^{n}\\mathrm{erfc}}\\left(z\\right)=-\\frac{z}{n}\\mathop{\\mathrm{i}^{n-1}\\mathrm{erfc}}\\left(z\\right)+\\frac{1}{2n}\\mathop{\\mathrm{i}^{n-2}\\mathrm{erfc}}\\left(z\\right),"
  ],
  [
   "7.18.8",
   "(-1)^{n}\\mathop{\\mathrm{i}^{n}\\mathrm{erfc}}\\left(z\\right)+\\mathop{\\mathrm{i}^{n}\\mathrm{erfc}}\\left(-z\\right)=\\frac{i^{-n}}{2^{n-1}n!}H_{n}\\left(iz\\right)."
  ],
  [
   "7.18.9",
   "\\mathop{\\mathrm{i}^{n}\\mathrm{erfc}}\\left(z\\right)=e^{-z^{2}}\\left(\\frac{1}{2^{n}\\Gamma\\left(\\tfrac{1}{2}n+1\\right)}M\\left(\\tfrac{1}{2}n+\\tfrac{1}{2},\\tfrac{1}{2},z^{2}\\right)-\\frac{z}{2^{n-1}\\Gamma\\left(\\tfrac{1}{2}n+\\tfrac{1}{2}\\right)}M\\left(\\tfrac{1}{2}n+1,\\tfrac{3}{2},z^{2}\\right)\\right),"
  ],
  [
   "7.18.10",
   "\\mathop{\\mathrm{i}^{n}\\mathrm{erfc}}\\left(z\\right)=\\frac{e^{-z^{2}}}{2^{n}\\sqrt{\\pi}}U\\left(\\tfrac{1}{2}n+\\tfrac{1}{2},\\tfrac{1}{2},z^{2}\\right)."
  ],
  [
   "7.18.11",
   "\\mathop{\\mathrm{i}^{n}\\mathrm{erfc}}\\left(z\\right)=\\frac{e^{-z^{2}/2}}{\\sqrt{2^{n-1}\\pi}}U\\left(n+\\tfrac{1}{2},z\\sqrt{2}\\right)."
  ],
  [
   "7.18.12",
   "\\mathop{\\mathrm{i}^{n}\\mathrm{erfc}}\\left(z\\right)=\\frac{1}{\\sqrt{2^{n-1}\\pi}}\\mathit{Hh}_{n}\\left(\\sqrt{2}z\\right)."
  ],
  [
   "7.18.13",
   "\\frac{\\mathop{\\mathrm{i}^{n}\\mathrm{erfc}}\\left(z\\right)}{\\mathop{\\mathrm{i}^{n-1}\\mathrm{erfc}}\\left(z\\right)}=\\cfrac{1/2}{z+\\cfrac{(n+1)/2}{z+\\cfrac{(n+2)/2}{z+}}}\\cdots,"
  ],
  [
   "7.18.14",
   "\\mathop{\\mathrm{i}^{n}\\mathrm{erfc}}\\left(z\\right)\\sim\\frac{2}{\\sqrt{\\pi}}\\frac{e^{-z^{2}}}{(2z)^{n+1}}\\sum_{m=0}^{\\infty}\\frac{(-1)^{m}(2m+n)!}{n!m!(2z)^{2m}},"
  ]
