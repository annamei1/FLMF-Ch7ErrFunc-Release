  "\\int_{0}^{x}e^{at^{2}}\\,\\mathrm{d}t<\\frac{1}{3ax}\\left(2e^{ax^{2}}+ax^{2}-2\\right),",
  "\\,\\mathrm{d}\\NVar{x}",
  "\\mathrm{e}",
